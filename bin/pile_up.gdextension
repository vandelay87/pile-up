[configuration]

entry_symbol = "pile_up_init"
compatibility_minimum = "4.5"

[libraries]

macos = "res://bin/libpileup.macos.template_release.universal.dylib"
windows.x86_64 = "res://bin/libpileup.windows.template_release.x86_64.dll"
linux.x86_64 = "res://bin/libpileup.linux.template_release.x86_64.so"
